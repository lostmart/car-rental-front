{
  "permissions": {
    "allow": [
      "Bash(git mv:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint)",
      "Bash(npm --version)",
      "Bash(test:*)",
      "Bash(npm info:*)",
      "Bash(timeout 5 npm run dev:*)",
      "Bash(npm run test:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(npm test)",
      "Bash(npx vitest:*)",
      "Bash(npm test:*)",
      "Bash(echo:*)",
      "Bash(npx tsc:*)",
      "Bash(powershell -Command \"npm test -- --run --reporter=verbose 2>&1 | Select-Object -First 100\")",
      "Bash(powershell -Command \"npm test -- --run 2>&1 | Select-Object -First 50\")",
      "Bash(powershell -Command \"npm test -- --run -u 2>&1 | Select-Object -First 30\")",
      "Bash(powershell:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "agent-router"
  ]
}
